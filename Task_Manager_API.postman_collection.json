{
    "info": {
        "_postman_id": "task-manager-api-week3",
        "name": "Task Manager API",
        "description": "Week 3 Task Manager REST API with JWT authentication.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:5000"
        },
        {
            "key": "token",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Home",
            "request": {
                "method": "GET",
                "header": [],
                "url": "{{base_url}}/"
            }
        },
        {
            "name": "Hello",
            "request": {
                "method": "GET",
                "header": [],
                "url": "{{base_url}}/hello"
            }
        },
        {
            "name": "Register",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"username\": \"newuser\",\n    \"password\": \"test123\"\n}"
                },
                "url": "{{base_url}}/register"
            }
        },
        {
            "name": "Login",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"username\": \"manoj\",\n    \"password\": \"test123\"\n}"
                },
                "url": "{{base_url}}/login"
            }
        },
        {
            "name": "Get All Tasks",
            "request": {
                "method": "GET",
                "header": [],
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{token}}",
                            "type": "string"
                        }
                    ]
                },
                "url": "{{base_url}}/tasks"
            }
        },
        {
            "name": "Create Task",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{token}}",
                            "type": "string"
                        }
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"title\": \"Learn REST API\",\n    \"description\": \"Complete Week 3 Task Manager project\"\n}"
                },
                "url": "{{base_url}}/tasks"
            }
        },
        {
            "name": "Get Single Task",
            "request": {
                "method": "GET",
                "header": [],
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{token}}",
                            "type": "string"
                        }
                    ]
                },
                "url": "{{base_url}}/tasks/2"
            }
        },
        {
            "name": "Update Task",
            "request": {
                "method": "PUT",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{token}}",
                            "type": "string"
                        }
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"title\": \"Learn REST API\",\n    \"description\": \"Complete Week 3 Task Manager project\",\n    \"completed\": true\n}"
                },
                "url": "{{base_url}}/tasks/2"
            }
        },
        {
            "name": "Delete Task",
            "request": {
                "method": "DELETE",
                "header": [],
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{token}}",
                            "type": "string"
                        }
                    ]
                },
                "url": "{{base_url}}/tasks/2"
            }
        }
    ]
}